{
  "uid": "data-drift",
  "title": "Data Drift (Evidently)",
  "description": "Evidently data drift of prediction inputs (current window) against the released training images (reference). Written by POST /monitoring/drift.",
  "tags": [
    "anomaly-detection",
    "drift",
    "evidently"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "category",
        "label": "Category",
        "type": "custom",
        "query": "bottle,wood,pill",
        "current": {
          "selected": true,
          "text": "bottle",
          "value": "bottle"
        },
        "options": [
          {
            "selected": true,
            "text": "bottle",
            "value": "bottle"
          },
          {
            "selected": false,
            "text": "wood",
            "value": "wood"
          },
          {
            "selected": false,
            "text": "pill",
            "value": "pill"
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dataset drift (latest evaluation)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN dataset_drift THEN 1 ELSE 0 END AS \"Dataset drift\"\nFROM drift_reports\nWHERE category = '$category'\nORDER BY evaluated_at DESC\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO DRIFT",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "DRIFT DETECTED",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Drifted features",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT drifted_features AS \"Drifted\", total_features AS \"Monitored\"\nFROM drift_reports\nWHERE category = '$category'\nORDER BY evaluated_at DESC\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Drift share",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT drift_share AS \"Drift share\"\nFROM drift_reports\nWHERE category = '$category'\nORDER BY evaluated_at DESC\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Evaluation window (latest evaluation)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT window_start AS \"Window start\",\n       evaluated_at AS \"Evaluated at\",\n       current_rows AS \"Predictions in window\",\n       reference_rows AS \"Reference images\"\nFROM drift_reports\nWHERE category = '$category'\nORDER BY evaluated_at DESC\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Per-feature drift (latest evaluation)",
      "description": "Drift score of the Evidently test (for K-S: p-value, drift when below the threshold).",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT feature AS \"Feature\",\n       method AS \"Test\",\n       drift_score AS \"Drift score\",\n       threshold AS \"Threshold\",\n       CASE WHEN drifted THEN 'DRIFT' ELSE 'OK' END AS \"Status\"\nFROM drift_feature_results\nWHERE report_id = (\n    SELECT id\n    FROM drift_reports\n    WHERE category = '$category'\n    ORDER BY evaluated_at DESC\n    LIMIT 1\n)\nORDER BY feature"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Drift score"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "DRIFT": {
                        "text": "DRIFT",
                        "color": "red",
                        "index": 0
                      },
                      "OK": {
                        "text": "OK",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Drift share over time",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT evaluated_at AS time, drift_share AS \"Drift share\"\nFROM drift_reports\nWHERE category = '$category'\n  AND $__timeFilter(evaluated_at)\nORDER BY evaluated_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Per-feature drift score over time",
      "description": "For K-S tests the score is a p-value: lower means stronger drift (threshold 0.05).",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT r.evaluated_at AS time, f.feature AS metric, f.drift_score AS value\nFROM drift_feature_results f\nJOIN drift_reports r ON r.id = f.report_id\nWHERE r.category = '$category'\n  AND $__timeFilter(r.evaluated_at)\nORDER BY r.evaluated_at"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}